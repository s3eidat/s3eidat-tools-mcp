{
  "name": "s3eidat-tools-mcp",
  "version": "0.1.0",
  "description": "S3eidat Tools as a local MCP server: PDF, image, text, developer and calculator tools for AI assistants. Runs on your machine; files are never uploaded.",
  "type": "module",
  "bin": {
    "s3eidat-tools-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "pretest": "npm run build",
    "start": "node dist/index.js",
    "docs": "npm run build && node scripts/gen-docs.mjs",
    "prepublishOnly": "npm run build && vitest run",
    "smoke": "node scripts/smoke.mjs",
    "mcpb": "npm run build && node scripts/build-mcpb.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "pdf",
    "image",
    "tools",
    "privacy",
    "local",
    "s3eidat"
  ],
  "author": "Omar (s3eidat)",
  "license": "MIT",
  "homepage": "https://s3eidat.github.io/s3eidat-tools-mcp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s3eidat/s3eidat-tools-mcp.git"
  },
  "bugs": "https://github.com/s3eidat/s3eidat-tools-mcp/issues",
  "mcpName": "io.github.s3eidat/s3eidat-tools-mcp",
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.0.13",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "ajv": "^8.20.0",
    "alasql": "^4.22.0",
    "docx": "^9.15.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "file-type": "^21.3.4",
    "franc-min": "^6.2.0",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "^5.5.0",
    "jsqr": "^1.4.0",
    "libphonenumber-js": "^1.13.15",
    "linkedom": "^0.18.14",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "music-metadata": "^11.16.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pixelmatch": "^8.0.0",
    "pptxgenjs": "^4.0.1",
    "robots-parser": "^3.0.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
