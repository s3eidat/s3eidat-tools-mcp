  {
   "key": "dev",
   "title": "Developer: utilities",
   "blurb": "Hashes, Base64, URLs, JWT, IDs, regex, cron, timestamps, subnets, chmod, HTTP status, .gitignore.",
   "tools": [
    {
     "name": "hash_compute",
     "title": "Hash (MD5 / SHA)",
     "group": "dev",
     "description": "Compute MD5, SHA-1, SHA-256 and SHA-512 of text or a file (path or base64), optionally an HMAC with a key, and check against an expected checksum (hex in any case/spacing, \"SHA256 (file) = …\" lines, or base64). Web version: https://s3eidat.github.io/hash-lab/",
     "web": "https://s3eidat.github.io/hash-lab/",
     "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
     },
     "inputs": [
      {
       "name": "text",
       "type": "string",
       "required": false,
       "description": "Text to hash (UTF-8)."
      },
      {
       "name": "file",
       "type": "string",
       "required": false,
       "description": "Or: a file to hash: local path or base64."
      },
      {
       "name": "hmacKey",
       "type": "string",
       "required": false,
       "description": "If set, also compute HMAC with this key."
      },
      {
       "name": "hmacAlgorithm",
       "type": "\"SHA-1\" | \"SHA-256\" | \"SHA-384\" | \"SHA-512\"",
       "required": false,
       "default": "SHA-256",
       "description": ""
      },
      {
       "name": "format",
       "type": "\"hex\" | \"HEX\" | \"base64\"",
       "required": false,
       "default": "hex",
       "description": "Output encoding."
      },
      {
       "name": "expected",
       "type": "string",
       "required": false,
       "description": "A checksum to compare against; the result says which algorithm matched."
      }
     ],
     "outputs": [
      {
       "name": "bytes",
       "type": "number",
       "required": true,
       "description": ""
      },
      {
       "name": "hashes",
       "type": "object",
       "required": true,
       "description": ""
      },
      {
       "name": "match",
       "type": "string | null",
       "required": false,
       "description": ""
      }
     ],
     "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
       "text": {
        "description": "Text to hash (UTF-8).",
        "type": "string"
       },
       "file": {
        "description": "Or: a file to hash: local path or base64.",
        "type": "string"
       },
       "hmacKey": {
        "description": "If set, also compute HMAC with this key.",
        "type": "string"
       },
       "hmacAlgorithm": {
        "default": "SHA-256",
        "type": "string",
        "enum": [
         "SHA-1",
         "SHA-256",
         "SHA-384",
         "SHA-512"
        ]
       },
       "format": {
        "default": "hex",
        "description": "Output encoding.",
        "type": "string",
        "enum": [
         "hex",
         "HEX",
         "base64"
        ]
       },
       "expected": {
        "description": "A checksum to compare against; the result says which algorithm matched.",
        "type": "string"
       }
      }
     },
     "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
       "bytes": {
        "type": "number"
       },
       "hashes": {
        "type": "object",
        "propertyNames": {
         "type": "string"
        },
        "additionalProperties": {
         "type": "string"
        }
       },
       "match": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "bytes",
       "hashes"
      ]
     },
     "examples": [
      {
       "input": {
        "text": "abc"
       },
       "note": "SHA-256 = ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
       "output": {
        "bytes": 3,
        "hashes": {
         "MD5": "900150983cd24fb0d6963f7d28e17f72",
         "SHA-1": "a9993e364706816aba3e25717850c26c9cd0d89d",
         "SHA-256": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
         "SHA-512": "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
        }
       }
      }
     ]
    }
   ]
  }
 ]
}