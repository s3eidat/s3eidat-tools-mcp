{
 "name": "s3eidat-tools-mcp",
 "version": "0.1.0",
 "count": 3,
 "groups": [
  {
   "key": "text",
   "title": "Text",
   "blurb": "Counting, case, slugs, cleaning, diffs, readability, Arabic tools, numbers to words, citations.",
   "tools": [
    {
     "name": "text_case",
     "title": "Case convert",
     "group": "text",
     "description": "Convert text case: upper, lower, title (smart: keeps small words lower and iPhone/NASA as typed), sentence, camel, pascal, snake, kebab, constant, alternate, inverse. Works line by line and handles Unicode (Arabic, accents, ß). Web version: https://s3eidat.github.io/case-convert/",
     "web": "https://s3eidat.github.io/case-convert/",
     "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
     },
     "inputs": [
      {
       "name": "text",
       "type": "string",
       "required": true,
       "description": "Text to convert."
      },
      {
       "name": "mode",
       "type": "\"upper\" | \"lower\" | \"title\" | \"sentence\" | \"camel\" | \"pascal\" | \"snake\" | \"kebab\" | \"constant\" | \"alternate\" | \"inverse\"",
       "required": true,
       "description": "Target case."
      }
     ],
     "outputs": [
      {
       "name": "result",
       "type": "string",
       "required": true,
       "description": ""
      }
     ],
     "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
       "text": {
        "type": "string",
        "description": "Text to convert."
       },
       "mode": {
        "type": "string",
        "enum": [
         "upper",
         "lower",
         "title",
         "sentence",
         "camel",
         "pascal",
         "snake",
         "kebab",
         "constant",
         "alternate",
         "inverse"
        ],
        "description": "Target case."
       }
      },
      "required": [
       "text",
       "mode"
      ]
     },
     "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
       "result": {
        "type": "string"
       }
      },
      "required": [
       "result"
      ]
     },
     "examples": [
      {
       "input": {
        "text": "a tale OF two cities",
        "mode": "title"
       },
       "output": {
        "result": "A Tale of Two Cities"
       }
      },
      {
       "input": {
        "text": "XMLParser handler",
        "mode": "snake"
       },
       "output": {
        "result": "xml_parser_handler"
       }
      }
     ]
    },
    {
     "name": "text_word_count",
     "title": "Word count",
     "group": "text",
     "description": "Count words, characters (with and without spaces), sentences, paragraphs, lines and unique words; estimate reading (238 wpm) and speaking (150 wpm) time; list the most used keywords with density. Works for English and Arabic (tashkeel ignored). Give \"text\" or a text file \"path\". Web version: https://s3eidat.github.io/word-count/",
     "web": "https://s3eidat.github.io/word-count/",
     "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
     },
     "inputs": [
      {
       "name": "text",
       "type": "string",
       "required": false,
       "description": "The text to analyse."
      },
      {
       "name": "path",
       "type": "string",
       "required": false,
       "description": "Or: a path to a UTF-8 text file."
      },
      {
       "name": "keywords",
       "type": "integer",
       "required": false,
       "default": 12,
       "description": "How many top keywords to return (0 = none)."
      },
      {
       "name": "includeStopWords",
       "type": "boolean",
       "required": false,
       "default": false,
       "description": "Count common words like \"the\"/\"في\" as keywords."
      }
     ],
     "outputs": [
      {
       "name": "words",
       "type": "number",
       "required": true,
       "description": ""
      },
      {
       "name": "characters",
       "type": "number",
       "required": true,
       "description": ""
      },
      {
       "name": "charactersNoSpaces",
       "type": "number",
       "required": true,
       "description": ""
      },
      {
       "name": "sentences",
       "type": "number",
       "required": true,
       "description": ""
      },
      {
       "name": "paragraphs",
       "type": "number",
       "required": true,
       "description": ""
      },
      {
       "name": "lines",
       "type": "number",
       "required": true,
       "description": ""
      },
      {
       "name": "uniqueWords",
       "type": "number",
       "required": true,
       "description": ""
      },
      {
       "name": "averageWordLength",
       "type": "number",
       "required": true,
       "description": ""
      },
      {
       "name": "longestWord",
       "type": "string",
       "required": true,
       "description": ""
      },
      {
       "name": "readingTimeSeconds",
       "type": "number",
       "required": true,
       "description": ""
      },
      {
       "name": "speakingTimeSeconds",
       "type": "number",
       "required": true,
       "description": ""
      },
      {
       "name": "keywords",
       "type": "object[]",
       "required": true,
       "description": ""
      }
     ],
     "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
       "text": {
        "description": "The text to analyse.",
        "type": "string"
       },
       "path": {
        "description": "Or: a path to a UTF-8 text file.",
        "type": "string"
       },
       "keywords": {
        "default": 12,
        "description": "How many top keywords to return (0 = none).",
        "type": "integer",
        "minimum": 0,
        "maximum": 100
       },
       "includeStopWords": {
        "default": false,
        "description": "Count common words like \"the\"/\"في\" as keywords.",
        "type": "boolean"
       }
      }
     },
     "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
       "words": {
        "type": "number"
       },
       "characters": {
        "type": "number"
       },
       "charactersNoSpaces": {
        "type": "number"
       },
       "sentences": {
        "type": "number"
       },
       "paragraphs": {
        "type": "number"
       },
       "lines": {
        "type": "number"
       },
       "uniqueWords": {
        "type": "number"
       },
       "averageWordLength": {
        "type": "number"
       },
       "longestWord": {
        "type": "string"
       },
       "readingTimeSeconds": {
        "type": "number"
       },
       "speakingTimeSeconds": {
        "type": "number"
       },
       "keywords": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "word": {
           "type": "string"
          },
          "count": {
           "type": "number"
          },
          "density": {
           "type": "number"
          }
         },
         "required": [
          "word",
          "count",
          "density"
         ]
        }
       }
      },
      "required": [
       "words",
       "characters",
       "charactersNoSpaces",
       "sentences",
       "paragraphs",
       "lines",
       "uniqueWords",
       "averageWordLength",
       "longestWord",
       "readingTimeSeconds",
       "speakingTimeSeconds",
       "keywords"
      ]
     },
     "examples": [
      {
       "input": {
        "text": "Hello world. This is a test! Is it?\n\nNew paragraph here."
       },
       "note": "11 words, 4 sentences, 2 paragraphs",
       "output": {
        "words": 11,
        "characters": 56,
        "charactersNoSpaces": 45,
        "sentences": 4,
        "paragraphs": 2,
        "lines": 3,
        "uniqueWords": 10,
        "averageWordLength": 3.73,
        "longestWord": "paragraph",
        "readingTimeSeconds": 3,
        "speakingTimeSeconds": 4,
        "keywords": [
